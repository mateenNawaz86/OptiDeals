# Base URL of the backend API.
# Falls back to http://localhost:4000 when unset (see lib/config.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Serve in-memory fixtures for modules without a backend yet.
# Set to "false" once the endpoints are live.
NEXT_PUBLIC_USE_MOCK_API=true

# Public URL of the site, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
